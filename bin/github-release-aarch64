#!/bin/bash

# Thin GitHub Release backend for the fork's native AArch64 repositories.
# Package discovery, channel eligibility, version comparison, building, and
# package signing remain delegated to the regular Omarchy package tooling.

set -euo pipefail

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/docker-helpers.sh"
source "$BUILD_ROOT/helpers/package-metadata.sh"

ARCH=aarch64
CHANNEL=${AARCH64_CHANNEL:-edge}
SCOPE="$BUILD_ROOT/config/aarch64-packages"
FORK_SCOPE="$BUILD_ROOT/config/aarch64-fork-packages"
REPOSITORY=${GITHUB_REPOSITORY:-riverscn/omarchy-pkgs-aarch64}
RELEASE_TAG=${AARCH64_RELEASE_TAG:-}
SOURCE_RELEASE_TAG=""
FROM_CHANNEL=""
TO_CHANNEL=""
NO_BASELINE=false
BOOTSTRAP=false
ALLOW_EMPTY_BASELINE=false

usage() {
  cat <<EOF
Usage: $0 <command> [OPTIONS]

Commands:
  seed         Download and verify one channel's rolling repository metadata
  build        Build packages that are native to the selected channel
  prepare      Sign, assemble, and validate the next repository snapshot
  publish      Atomically update the selected channel's GitHub Release
  run          Run seed, build, prepare, and publish
  full-rebuild Build and validate the complete edge scope from an empty repository
  scope        Validate and print the selected channel's repository scope
  build-scope  Validate and print packages built natively in the channel
  advance      Move packages forward through edge -> rc -> stable

Options:
  --channel <edge|rc|stable>  Repository channel (default: edge)
  --repository <owner/repo>   GitHub repository (default: GITHUB_REPOSITORY)
  --tag <tag>                 Target Release tag (must equal aarch64-<channel>)
  --source-tag <tag>          Source Release tag for advance
  --from <channel>            Source channel for advance
  --to <channel>              Destination channel for advance
  --bootstrap                 Allow the one-time stable -> rc bootstrap
  --no-baseline              Do not read the existing edge Release
EOF
}

valid_channel() {
  case "$1" in edge|rc|stable) return 0 ;; *) return 1 ;; esac
}

COMMAND=${1:-}
[[ -n $COMMAND ]] || { usage; exit 1; }
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    --channel) [[ $# -ge 2 ]] || { echo "ERROR: --channel needs a value" >&2; exit 1; }; CHANNEL=$2; shift 2 ;;
    --repository) [[ $# -ge 2 ]] || { echo "ERROR: --repository needs a value" >&2; exit 1; }; REPOSITORY=$2; shift 2 ;;
    --tag) [[ $# -ge 2 ]] || { echo "ERROR: --tag needs a value" >&2; exit 1; }; RELEASE_TAG=$2; shift 2 ;;
    --source-tag) [[ $# -ge 2 ]] || { echo "ERROR: --source-tag needs a value" >&2; exit 1; }; SOURCE_RELEASE_TAG=$2; shift 2 ;;
    --from) [[ $# -ge 2 ]] || { echo "ERROR: --from needs a value" >&2; exit 1; }; FROM_CHANNEL=$2; shift 2 ;;
    --to) [[ $# -ge 2 ]] || { echo "ERROR: --to needs a value" >&2; exit 1; }; TO_CHANNEL=$2; shift 2 ;;
    --bootstrap) BOOTSTRAP=true; shift ;;
    --no-baseline) NO_BASELINE=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ $COMMAND == advance ]]; then
  [[ -n $FROM_CHANNEL && -n $TO_CHANNEL ]] || {
    echo "ERROR: advance requires --from and --to" >&2
    exit 1
  }
  CHANNEL=$TO_CHANNEL
fi
valid_channel "$CHANNEL" || { echo "ERROR: invalid channel: $CHANNEL" >&2; exit 1; }
[[ -z $FROM_CHANNEL ]] || valid_channel "$FROM_CHANNEL" || {
  echo "ERROR: invalid source channel: $FROM_CHANNEL" >&2
  exit 1
}
[[ $REPOSITORY =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
  echo "ERROR: invalid GitHub repository: $REPOSITORY" >&2
  exit 1
}
[[ -z $RELEASE_TAG || $RELEASE_TAG =~ ^[A-Za-z0-9._-]+$ ]] || {
  echo "ERROR: invalid target Release tag: $RELEASE_TAG" >&2
  exit 1
}
[[ -z $SOURCE_RELEASE_TAG || $SOURCE_RELEASE_TAG =~ ^[A-Za-z0-9._-]+$ ]] || {
  echo "ERROR: invalid source Release tag: $SOURCE_RELEASE_TAG" >&2
  exit 1
}

if [[ $NO_BASELINE == true && $COMMAND != seed && $COMMAND != run && $COMMAND != full-rebuild ]]; then
  echo "ERROR: --no-baseline is valid only with seed, run, or full-rebuild" >&2
  exit 1
fi
if [[ $NO_BASELINE == true && $CHANNEL != edge ]]; then
  echo "ERROR: zero-baseline validation applies only to edge; rc and stable are populated by channel advancement" >&2
  exit 1
fi
if [[ $COMMAND == full-rebuild && $CHANNEL != edge ]]; then
  echo "ERROR: full-rebuild applies only to edge" >&2
  exit 1
fi
if [[ $BOOTSTRAP == true && $COMMAND != advance ]]; then
  echo "ERROR: --bootstrap is valid only with advance" >&2
  exit 1
fi

MIRROR=$CHANNEL
RELEASE_TAG=${RELEASE_TAG:-"aarch64-$CHANNEL"}
[[ $RELEASE_TAG == "aarch64-$CHANNEL" ]] || {
  echo "ERROR: target Release tag '$RELEASE_TAG' does not match managed channel tag 'aarch64-$CHANNEL'" >&2
  exit 1
}
REPO_DIR="$BUILD_ROOT/pkgs.omarchy.org/$MIRROR/$ARCH"
BUILD_OUTPUT_DIR="$BUILD_ROOT/build-output/$MIRROR/$ARCH"
FULL_REBUILD_MARKER="$REPO_DIR/.full-rebuild-validation"
CHANNEL_SCOPE="$REPO_DIR/.channel-package-scope"
CHANNEL_FORK_SCOPE="$REPO_DIR/.channel-fork-scope"

configured_scope_packages() {
  sed -E '/^[[:space:]]*(#|$)/d' "$SCOPE" "$FORK_SCOPE"
}

channel_scope_packages() {
  local scope_file=$1 package pkgdir
  while IFS= read -r package; do
    pkgdir="$BUILD_ROOT/pkgbuilds/$package"
    package_in_channel "$pkgdir" "$CHANNEL" && printf '%s\n' "$package"
  done < <(sed -E '/^[[:space:]]*(#|$)/d' "$scope_file")
  return 0
}

repository_scope_packages() {
  channel_scope_packages "$SCOPE"
  channel_scope_packages "$FORK_SCOPE"
}

build_scope_packages() {
  local package pkgdir
  while IFS= read -r package; do
    pkgdir="$BUILD_ROOT/pkgbuilds/$package"
    package_builds_for_mirror "$pkgdir" "$CHANNEL" && printf '%s\n' "$package"
  done < <(repository_scope_packages)
  return 0
}

validate_scope() {
  [[ -f $SCOPE ]] || { echo "ERROR: missing package scope: $SCOPE" >&2; return 1; }
  [[ -f $FORK_SCOPE ]] || { echo "ERROR: missing fork package scope: $FORK_SCOPE" >&2; return 1; }

  local package count=0 channel_count=0
  declare -A seen=()
  while IFS= read -r package; do
    [[ $package =~ ^[a-zA-Z0-9@._+-]+$ ]] || {
      echo "ERROR: invalid package base in scope: $package" >&2
      return 1
    }
    [[ -z ${seen[$package]:-} ]] || {
      echo "ERROR: duplicate package base in scope: $package" >&2
      return 1
    }
    seen[$package]=1
    [[ -f $BUILD_ROOT/pkgbuilds/$package/PKGBUILD ]] || {
      echo "ERROR: scoped package base has no PKGBUILD: $package" >&2
      return 1
    }
    ((count += 1))
  done < <(configured_scope_packages)
  (( count > 0 )) || { echo "ERROR: package scope is empty" >&2; return 1; }

  while IFS= read -r package; do ((channel_count += 1)); done < <(repository_scope_packages)
  (( channel_count > 0 )) || { echo "ERROR: $CHANNEL repository scope is empty" >&2; return 1; }
  echo "Validated $channel_count AArch64 package bases for $CHANNEL ($count configured)."
}

write_channel_scope() {
  mkdir -p "$REPO_DIR"
  channel_scope_packages "$SCOPE" > "$CHANNEL_SCOPE"
  channel_scope_packages "$FORK_SCOPE" > "$CHANNEL_FORK_SCOPE"
}

require_native_arm() {
  case "$(uname -m)" in
    aarch64|arm64) ;;
    *)
      echo "ERROR: AArch64 releases require a native ARM runner; emulation is intentionally unsupported." >&2
      return 1
      ;;
  esac
}

checked_in_public_key() {
  echo "$BUILD_ROOT/pkgbuilds/omarchy-aarch64-keyring/omarchy-aarch64.gpg"
}

expected_fingerprint() {
  tr -d '[:space:]' < "$BUILD_ROOT/config/aarch64-signing-fingerprint"
}

verify_public_key() {
  local key=$1 expected actual key_home
  expected=$(expected_fingerprint)
  [[ $expected =~ ^[0-9A-F]{40}$ ]] || {
    echo "ERROR: invalid configured signing fingerprint" >&2
    return 1
  }
  key_home=$(mktemp -d)
  chmod 700 "$key_home"
  actual=$(GNUPGHOME=$key_home gpg --batch --show-keys --with-colons "$key" 2>/dev/null |
    awk -F: '$1 == "fpr" { print $10; exit }')
  rm -rf "$key_home"
  [[ $actual == "$expected" ]] || {
    echo "ERROR: public key fingerprint mismatch: ${actual:-missing}" >&2
    return 1
  }
}

download_release_metadata() {
  local tag=$1 destination=$2 expected_channel=$3 verify_home
  mkdir -p "$destination"
  gh release download "$tag" --repo "$REPOSITORY" --dir "$destination" \
    --pattern 'omarchy.db' \
    --pattern 'omarchy.db.sig' \
    --pattern 'omarchy.db.tar.zst' \
    --pattern 'omarchy.db.tar.zst.sig' \
    --pattern 'omarchy.files' \
    --pattern 'omarchy.files.sig' \
    --pattern 'omarchy.files.tar.zst' \
    --pattern 'omarchy.files.tar.zst.sig' \
    --pattern 'repository-build-audit.json' \
    --pattern 'repository-manifest.json' \
    --pattern 'omarchy-aarch64.gpg' \
    --pattern 'SHA256SUMS'

  for required in SHA256SUMS omarchy.db.tar.zst omarchy.db.tar.zst.sig repository-manifest.json; do
    [[ -f $destination/$required ]] || {
      echo "ERROR: $tag lacks $required" >&2
      return 1
    }
  done
  (cd "$destination" && sha256sum --check --ignore-missing SHA256SUMS)

  verify_home=$(mktemp -d)
  chmod 700 "$verify_home"
  GNUPGHOME=$verify_home gpg --batch --import "$(checked_in_public_key)" >/dev/null 2>&1
  GNUPGHOME=$verify_home gpg --batch --verify \
    "$destination/omarchy.db.tar.zst.sig" "$destination/omarchy.db.tar.zst" >/dev/null
  rm -rf "$verify_home"

  [[ $(jq -r '.architecture // ""' "$destination/repository-manifest.json") == aarch64 ]] || {
    echo "ERROR: $tag manifest is not an AArch64 repository" >&2
    return 1
  }
  [[ $(jq -r '.channel // ""' "$destination/repository-manifest.json") == "$expected_channel" ]] || {
    echo "ERROR: $tag manifest does not identify the $expected_channel channel" >&2
    return 1
  }
}

seed_repository() (
  command -v gpg >/dev/null || { echo "ERROR: gpg is required" >&2; return 1; }
  validate_scope >/dev/null
  verify_public_key "$(checked_in_public_key)"

  rm -rf "$REPO_DIR"
  mkdir -p "$REPO_DIR"
  write_channel_scope

  if [[ $NO_BASELINE == true ]]; then
    touch "$FULL_REBUILD_MARKER"
    echo "Initialized an empty, non-publishable edge validation repository."
    return 0
  fi

  command -v gh >/dev/null || { echo "ERROR: gh is required" >&2; return 1; }

  if ! gh release view "$RELEASE_TAG" --repo "$REPOSITORY" >/dev/null 2>&1; then
    if [[ $CHANNEL != edge && $ALLOW_EMPTY_BASELINE != true ]]; then
      echo "ERROR: $RELEASE_TAG is not initialized; populate $CHANNEL through the forward channel pipeline first" >&2
      return 1
    fi
    echo "No $RELEASE_TAG Release found; initializing an empty $CHANNEL repository."
    return 0
  fi

  local staging
  staging=$(mktemp -d)
  trap 'rm -rf "$staging"' EXIT
  download_release_metadata "$RELEASE_TAG" "$staging" "$CHANNEL"

  cp -- "$staging"/* "$REPO_DIR/"
  cp "$staging/SHA256SUMS" "$REPO_DIR/.baseline-SHA256SUMS"
  printf '%s\n' "$RELEASE_TAG" > "$REPO_DIR/.baseline-release-tag"
  write_channel_scope
  echo "Seeded and verified the signed $CHANNEL database from $RELEASE_TAG."
)

build_packages() {
  require_native_arm
  validate_scope >/dev/null
  mapfile -t packages < <(build_scope_packages)
  (( ${#packages[@]} > 0 )) || {
    echo "No package bases are built natively for $CHANNEL in this checkout."
    return 0
  }

  if [[ -f $FULL_REBUILD_MARKER ]]; then
    find "$REPO_DIR" -mindepth 1 -maxdepth 1 \
      ! -name "${FULL_REBUILD_MARKER##*/}" \
      ! -name "${CHANNEL_SCOPE##*/}" \
      ! -name "${CHANNEL_FORK_SCOPE##*/}" -exec rm -rf -- {} +
    "$BUILD_ROOT/bin/repo" build --local --arch "$ARCH" --mirror "$MIRROR" \
      --package "${packages[@]}"
  else
    OMARCHY_REPOSITORY_KEY="/pkgbuilds/omarchy-aarch64-keyring/omarchy-aarch64.gpg" \
      OMARCHY_REPOSITORY_KEY_FINGERPRINT="$(expected_fingerprint)" \
      OMARCHY_REPOSITORY_SERVER="https://github.com/$REPOSITORY/releases/download/$RELEASE_TAG" \
      "$BUILD_ROOT/bin/repo" build --local --arch "$ARCH" --mirror "$MIRROR" \
        --package "${packages[@]}"
  fi
}

prepare_repository() {
  require_native_arm
  validate_scope >/dev/null
  : "${GPG_PRIVATE_KEY:?GPG_PRIVATE_KEY is required}"
  : "${GPG_PASSPHRASE:?GPG_PASSPHRASE is required}"
  verify_public_key "$(checked_in_public_key)"
  write_channel_scope

  shopt -s nullglob
  local packages=("$BUILD_OUTPUT_DIR"/*.pkg.tar.zst)
  shopt -u nullglob
  rm -f "$REPO_DIR/.no-changes"
  if (( ${#packages[@]} > 0 )); then
    "$BUILD_ROOT/bin/repo" sign --local --arch "$ARCH" --mirror "$MIRROR"
    "$BUILD_ROOT/bin/normalize-github-release-packages" "$BUILD_OUTPUT_DIR"
    "$BUILD_ROOT/bin/repo" promote --local --arch "$ARCH" --mirror "$MIRROR"
  fi

  build_docker_image "$BUILD_ROOT/build" "$ARCH" "$MIRROR"
  read -r -a platform_args <<< "$(get_platform_arg "$ARCH")"
  local remote_repository_server validation_mode
  remote_repository_server="https://github.com/$REPOSITORY/releases/download/$RELEASE_TAG"
  validation_mode=incremental
  if [[ -f $FULL_REBUILD_MARKER ]]; then
    remote_repository_server=""
    validation_mode=full
  fi
  docker run --rm "${platform_args[@]}" --user root \
    -e GPG_PRIVATE_KEY="$GPG_PRIVATE_KEY" \
    -e GPG_PASSPHRASE="$GPG_PASSPHRASE" \
    -e EXPECTED_SIGNING_FINGERPRINT="$(expected_fingerprint)" \
    -e REMOTE_REPOSITORY_SERVER="$remote_repository_server" \
    -e REPOSITORY_CHANNEL="$CHANNEL" \
    -e PACKAGE_SCOPE=/repository/.channel-package-scope \
    -e FORK_PACKAGE_SCOPE=/repository/.channel-fork-scope \
    -e VALIDATION_MODE="$validation_mode" \
    -e GITHUB_SHA="${GITHUB_SHA:-unknown}" \
    -v "$REPO_DIR:/repository" \
    -v "$BUILD_ROOT/config:/config:ro" \
    -v "$BUILD_ROOT/pkgbuilds:/pkgbuilds:ro" \
    -v "$BUILD_ROOT/pkgbuilds/omarchy-aarch64-keyring:/public:ro" \
    -v "$BUILD_ROOT/build:/build:ro" \
    -v "$BUILD_ROOT/helpers:/helpers:ro" \
    "omarchy-pkg-builder:latest-$ARCH-$MIRROR" /build/github-release-prepare.sh
}

publish_repository() {
  if [[ -f $FULL_REBUILD_MARKER ]]; then
    echo "ERROR: a zero-baseline validation repository must never be published." >&2
    return 1
  fi
  if [[ -f $REPO_DIR/.no-changes ]]; then
    echo "No $CHANNEL package changes; skipping GitHub publication."
    return 0
  fi
  "$BUILD_ROOT/bin/publish-github-release" \
    --repository "$REPOSITORY" --repo-dir "$REPO_DIR" \
    --tag "$RELEASE_TAG" --channel "$CHANNEL"
}

validate_advance_direction() {
  case "$FROM_CHANNEL->$TO_CHANNEL" in
    "edge->rc"|"rc->stable")
      [[ $BOOTSTRAP == false ]] || {
        echo "ERROR: --bootstrap is only valid for stable -> rc" >&2
        return 1
      }
      ;;
    "stable->rc")
      [[ $BOOTSTRAP == true ]] || {
        echo "ERROR: stable -> rc requires --bootstrap" >&2
        return 1
      }
      ;;
    *)
      echo "ERROR: refusing $FROM_CHANNEL -> $TO_CHANNEL; releases move edge -> rc -> stable" >&2
      return 1
      ;;
  esac
}

database_manifest() {
  local database=$1
  tar -xOf "$database" --wildcards '*/desc' 2>/dev/null | awk '
    function emit() {
      if (name != "" && filename != "") printf "%s\t%s\t%s\n", name, base, filename
      name = ""; base = ""; filename = ""
    }
    $0 == "%FILENAME%" { emit(); getline; filename = $0; next }
    $0 == "%NAME%" { getline; name = $0; next }
    $0 == "%BASE%" { getline; base = $0; next }
    END { emit() }
  '
}

metadata_entry_map() {
  local package package_dir identities metadata_base package_name
  while IFS= read -r package; do
    package_dir="$BUILD_ROOT/pkgbuilds/$package"
    package_in_channel "$package_dir" "$TO_CHANNEL" || continue
    identities=$(cd "$package_dir" && CARCH=aarch64 bash -c '
      set -e
      source PKGBUILD >/dev/null
      resolved_base=${pkgbase:-${pkgname[0]:-}}
      [[ $resolved_base =~ ^[A-Za-z0-9@._+-]+$ ]] || exit 1
      for resolved_name in "${pkgname[@]}"; do
        [[ $resolved_name =~ ^[A-Za-z0-9@._+-]+$ ]] || exit 1
        printf "%s\t%s\n" "$resolved_base" "$resolved_name"
      done
    ') || {
      echo "ERROR: cannot evaluate package identities for $package" >&2
      return 1
    }
    while IFS=$'\t' read -r metadata_base package_name; do
      [[ -n $metadata_base && -n $package_name ]] &&
        printf '%s\t%s\t%s\n' "$metadata_base" "$package_name" "$package_dir"
    done <<< "$identities"
  done < <(configured_scope_packages)
}

checksum_for() {
  local sums=$1 wanted=$2
  awk -v wanted="$wanted" '
    { name=$2; sub(/^\*/, "", name) }
    name == wanted && $1 ~ /^[0-9a-f]{64}$/ { print $1; found=1; exit }
    END { exit !found }
  ' "$sums"
}

stage_advance() (
  require_native_arm
  validate_advance_direction
  command -v gh >/dev/null || { echo "ERROR: gh is required" >&2; return 1; }
  command -v tar >/dev/null || { echo "ERROR: tar is required" >&2; return 1; }

  local source_tag source_work entry_map name base filename key package_dir
  local source_hash source_sig_hash target_hash target_sig_hash local_hash local_sig_hash
  local staged staged_info staged_name staged_filename
  local copied=0 present=0 retained=0 replaced=0 skipped=0 asset
  local -a download_args=()
  source_tag=${SOURCE_RELEASE_TAG:-"aarch64-$FROM_CHANNEL"}
  source_work=$(mktemp -d)
  entry_map=$(mktemp)
  trap 'rm -rf "$source_work" "$entry_map"' EXIT
  download_release_metadata "$source_tag" "$source_work" "$FROM_CHANNEL"
  metadata_entry_map > "$entry_map"

  declare -A entry_dirs=()
  declare -A name_dirs=()
  declare -A download_hashes=()
  declare -A staged_filename_by_name=()
  while IFS=$'\t' read -r base name package_dir; do
    entry_dirs["$base:$name"]=$package_dir
    name_dirs["$name"]=$package_dir
  done < "$entry_map"

  # A one-time RC initialization may stage a stable baseline and then overlay
  # current forwardable edge packages before publishing anything. Record the
  # already staged package names so identical archives are reused and a newer
  # archive can replace the legacy version atomically in the local snapshot.
  shopt -s nullglob
  for staged in "$REPO_DIR"/*.pkg.tar.zst; do
    staged_info=$(tar -xOf "$staged" .PKGINFO) || {
      echo "ERROR: staged archive lacks readable .PKGINFO: ${staged##*/}" >&2
      return 1
    }
    staged_name=$(awk -F ' = ' '$1 == "pkgname" { print $2; exit }' <<< "$staged_info")
    [[ $staged_name =~ ^[A-Za-z0-9@._+-]+$ ]] || {
      echo "ERROR: staged archive has invalid package name: ${staged##*/}" >&2
      return 1
    }
    [[ -z ${staged_filename_by_name[$staged_name]:-} ]] || {
      echo "ERROR: multiple staged versions found for package $staged_name" >&2
      return 1
    }
    staged_filename_by_name["$staged_name"]=${staged##*/}
  done
  shopt -u nullglob

  while IFS=$'\t' read -r name base filename; do
    [[ $filename == "${filename##*/}" && $filename == *.pkg.tar.zst ]] || {
      echo "ERROR: unsafe package filename in $source_tag: $filename" >&2
      return 1
    }
    key="${base:-$name}:$name"
    package_dir=${entry_dirs[$key]:-${name_dirs[$name]:-}}
    if [[ -z $package_dir ]]; then
      ((skipped += 1))
      continue
    fi
    if [[ $BOOTSTRAP != true ]]; then
      # RC's pinned runtime pair is authoritative only when built from the
      # standing rc branch with OMARCHY_RC_PINS=1. Do not let a master's edge
      # snapshot pre-empt that candidate with independently built bytes.
      if [[ $TO_CHANNEL == rc ]] && package_is_pinned "$package_dir"; then
        ((skipped += 1))
        continue
      fi
      if ! package_moves_to_channel "$package_dir" "$TO_CHANNEL"; then
        ((skipped += 1))
        continue
      fi
    fi

    source_hash=$(checksum_for "$source_work/SHA256SUMS" "$filename") || {
      echo "ERROR: $source_tag checksum manifest lacks $filename" >&2
      return 1
    }
    source_sig_hash=$(checksum_for "$source_work/SHA256SUMS" "$filename.sig") || {
      echo "ERROR: $source_tag checksum manifest lacks $filename.sig" >&2
      return 1
    }
    target_hash=$(checksum_for "$REPO_DIR/.baseline-SHA256SUMS" "$filename" 2>/dev/null || true)
    target_sig_hash=$(checksum_for "$REPO_DIR/.baseline-SHA256SUMS" "$filename.sig" 2>/dev/null || true)

    # Chained staging reuses byte-identical archives already copied into the
    # unpublished target workspace. A forwardable package built separately in
    # stable and edge may legitimately have the same versioned filename but
    # different bytes; replace only the unpublished copy. Once that filename
    # exists in the target baseline it is immutable and authoritative for that
    # version.
    if [[ -e $REPO_DIR/$filename || -e $REPO_DIR/$filename.sig ]]; then
      [[ -f $REPO_DIR/$filename && -f $REPO_DIR/$filename.sig ]] || {
        echo "ERROR: staged package or signature is incomplete: $filename" >&2
        return 1
      }
      local_hash=$(sha256sum "$REPO_DIR/$filename" | awk '{ print $1 }')
      local_sig_hash=$(sha256sum "$REPO_DIR/$filename.sig" | awk '{ print $1 }')
      if [[ $local_hash == "$source_hash" && $local_sig_hash == "$source_sig_hash" ]]; then
        ((present += 1))
        continue
      fi
      [[ -z $target_hash && -z $target_sig_hash ]] || {
        echo "ERROR: $filename or its signature already exists in $TO_CHANNEL with different bytes" >&2
        return 1
      }
      rm -f -- "$REPO_DIR/$filename" "$REPO_DIR/$filename.sig"
      unset 'staged_filename_by_name[$name]'
      ((replaced += 1))
    fi

    if [[ -n $target_hash || -n $target_sig_hash ]]; then
      [[ -n $target_hash && -n $target_sig_hash ]] || {
        echo "ERROR: target checksum manifest is incomplete for $filename" >&2
        return 1
      }
      if [[ $target_hash == "$source_hash" && $target_sig_hash == "$source_sig_hash" ]]; then
        ((present += 1))
      else
        # GitHub Release assets and package-manager caches are immutable by
        # versioned filename. A separately built target artifact with the same
        # package version stays in place and is re-audited with the final
        # snapshot; changing its payload requires a pkgrel/pkgver bump.
        echo "Retaining immutable $TO_CHANNEL asset with the same package version: $filename" >&2
        ((retained += 1))
      fi
      continue
    fi

    staged_filename=${staged_filename_by_name[$name]:-}
    if [[ -n $staged_filename && $staged_filename != "$filename" ]]; then
      rm -f -- "$REPO_DIR/$staged_filename" "$REPO_DIR/$staged_filename.sig"
      unset 'staged_filename_by_name[$name]'
      ((replaced += 1))
    fi
    download_args+=(--pattern "$filename" --pattern "$filename.sig")
    download_hashes["$filename"]=$source_hash
    download_hashes["$filename.sig"]=$source_sig_hash
    ((copied += 1))
  done < <(database_manifest "$source_work/omarchy.db.tar.zst")

  # Resolve the Release asset listing once. Bootstrap can move hundreds of
  # assets; invoking `gh release download` for each package would turn one
  # forward channel operation into hundreds of redundant API requests.
  if (( ${#download_args[@]} > 0 )); then
    gh release download "$source_tag" --repo "$REPOSITORY" --dir "$REPO_DIR" \
      "${download_args[@]}"
  fi
  for asset in "${!download_hashes[@]}"; do
    [[ -f $REPO_DIR/$asset ]] || {
      echo "ERROR: source Release did not provide $asset" >&2
      return 1
    }
    [[ $(sha256sum "$REPO_DIR/$asset" | awk '{ print $1 }') == "${download_hashes[$asset]}" ]] || {
      echo "ERROR: downloaded asset checksum mismatch: $asset" >&2
      return 1
    }
  done

  echo "Staged $copied package(s) for $FROM_CHANNEL -> $TO_CHANNEL; $present byte-identical, $retained immutable target versions retained, $replaced superseded, $skipped not moved."
)

run_advance() {
  local initial_bootstrap=$BOOTSTRAP
  validate_advance_direction
  ALLOW_EMPTY_BASELINE=$BOOTSTRAP
  seed_repository
  stage_advance
  if [[ $BOOTSTRAP == true && $FROM_CHANNEL == stable && $TO_CHANNEL == rc ]]; then
    echo "Stable RC baseline staged; overlaying current forwardable edge packages before first publication."
    BOOTSTRAP=false
    FROM_CHANNEL=edge
    SOURCE_RELEASE_TAG=""
    stage_advance
  fi
  if [[ $initial_bootstrap != true ]]; then
    # GitHub jobs have no shared mutable repository workspace. Reconcile the
    # destination's native build ring in this unpublished transaction so a new
    # or reclassified package cannot make advancement depend on an earlier
    # partial channel publication.
    echo "Reconciling native $TO_CHANNEL packages before atomic advancement."
    build_packages
  fi
  prepare_repository
  publish_repository
}

case "$COMMAND" in
  seed) seed_repository ;;
  build) build_packages ;;
  prepare) prepare_repository ;;
  publish) publish_repository ;;
  scope) validate_scope; repository_scope_packages ;;
  build-scope) validate_scope; build_scope_packages ;;
  advance) run_advance ;;
  run)
    seed_repository
    build_packages
    prepare_repository
    if [[ $NO_BASELINE == true ]]; then
      echo "Full edge validation completed; publication is intentionally disabled."
    else
      publish_repository
    fi
    ;;
  full-rebuild)
    CHANNEL=edge
    MIRROR=edge
    RELEASE_TAG=${AARCH64_RELEASE_TAG:-aarch64-edge}
    REPO_DIR="$BUILD_ROOT/pkgs.omarchy.org/$MIRROR/$ARCH"
    BUILD_OUTPUT_DIR="$BUILD_ROOT/build-output/$MIRROR/$ARCH"
    FULL_REBUILD_MARKER="$REPO_DIR/.full-rebuild-validation"
    CHANNEL_SCOPE="$REPO_DIR/.channel-package-scope"
    CHANNEL_FORK_SCOPE="$REPO_DIR/.channel-fork-scope"
    NO_BASELINE=true
    seed_repository
    build_packages
    prepare_repository
    echo "Full edge validation completed; publication is intentionally disabled."
    ;;
  -h|--help|help) usage ;;
  *) echo "Unknown command: $COMMAND" >&2; usage >&2; exit 1 ;;
esac
