pkgname=libretro-desmume
pkgver=20260516.000420.gae0f7f51f96d
pkgrel=1
pkgdesc='Nintendo DS core'
arch=(x86_64 aarch64)
url=https://github.com/libretro/desmume
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  libgl
  libretro-core-info
)
makedepends=(
  git
  libpcap
  mesa
)
source=(libretro-desmume::git+https://github.com/libretro/desmume.git#commit=${pkgver##*.g})
b2sums=('94722bd1adad0b0d966d4f506d1bc341f9e729f2fefa5235aef78a875314247657c8196a3c81069c4cdd7c57004af42fb04f1f03f133a9e01c3d8b2fd70b11a6')

build() {
  make -C libretro-desmume/desmume/src/frontend/libretro -f Makefile.libretro
}

package() {
  install -Dm 644 libretro-desmume/desmume/src/frontend/libretro/desmume_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

