+		;;
+	aarch64 | arm64)
+		source_file="/usr/share/limine/BOOTAA64.EFI"
+		efi_suffix="aa64"
+		fallback_file="BOOTAA64.EFI"
+		systemd_boot_file="systemd-bootaa64.efi"
+		refind_file="refind_aa64.efi"
+		;;
+	*)
+		error_msg "Unsupported UEFI architecture: $(uname -m)"
