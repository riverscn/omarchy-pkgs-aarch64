+	export LIMINE_EFI_FILE="limine_${efi_suffix}.efi"
+	export LIMINE_BACKUP_FILE="limine_${efi_suffix}.bak"
 
 	export BINARY_TARGET_PATH="${LIMINE_DIR_PATH}${LIMINE_EFI_FILE}"
 	export BINARY_BACKUP_PATH="${LIMINE_DIR_PATH}${LIMINE_BACKUP_FILE}"
-	export BINARY_FALLBACK_PATH="${ESP_PATH}/EFI/BOOT/BOOTX64.EFI"
+	export BINARY_FALLBACK_PATH="${ESP_PATH}/EFI/BOOT/${fallback_file}"
 
 	export LIMINE_EFI_PATH="\\EFI\\limine\\${LIMINE_EFI_FILE}"
 	export LIMINE_CONFIG_PATH="${ESP_PATH}/limine.conf"
+	export UEFI_SYSTEMD_BOOT_FILE="$systemd_boot_file"
+	export UEFI_REFIND_FILE="$refind_file"
+	export UEFI_FALLBACK_FILE="$fallback_file"
 	return 0
 }
