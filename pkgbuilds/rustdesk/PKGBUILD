# Maintainer: Omarchy AArch64 maintainers

pkgname=rustdesk
pkgver=1.4.9
pkgrel=1
pkgdesc='Remote desktop software with an official AArch64 Linux client'
arch=('aarch64')
url='https://rustdesk.com/'
license=('AGPL-3.0-only')
depends=(
  'alsa-lib'
  'curl'
  'gst-plugin-pipewire'
  'gst-plugins-base-libs'
  'gtk3'
  'libva'
  'libxfixes'
  'libxcb'
  'pam'
  'procps-ng'
  'systemd-libs'
  'xdotool'
)
optdepends=('libappindicator-gtk3: tray icon support')
options=('!strip' '!debug')
install='rustdesk.install'

_filename="rustdesk-${pkgver}-aarch64.deb"
source_aarch64=("${_filename}::https://github.com/rustdesk/rustdesk/releases/download/${pkgver}/${_filename}")
noextract=("$_filename")
sha256sums_aarch64=('ce62c996f14d33f3bbe3a330e953644a44bace7f05885a7953f7395d69fb49c0')

package() {
  bsdtar -xOf "$srcdir/$_filename" data.tar.xz |
    bsdtar --no-same-owner -xJf - -C "$pkgdir"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/share/rustdesk/rustdesk "$pkgdir/usr/bin/rustdesk"

  install -Dm644 \
    "$pkgdir/usr/share/rustdesk/files/systemd/rustdesk.service" \
    "$pkgdir/usr/lib/systemd/system/rustdesk.service"
  sed -i 's|ExecStop=pkill|ExecStop=/usr/bin/pkill|' \
    "$pkgdir/usr/lib/systemd/system/rustdesk.service"
}
