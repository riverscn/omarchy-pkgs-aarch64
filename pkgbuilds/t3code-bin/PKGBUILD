# Maintainer: Omarchy AArch64

# Upstream publishes only an x86_64 Linux binary. Build the tagged source on
# the native ARM runner and retain Omarchy's exact package name.

pkgname=t3code-bin
pkgver=0.0.35
pkgrel=2
pkgdesc="Open-source control plane for coding agents (native AArch64 build)"
arch=('aarch64')
url="https://t3.codes"
license=('MIT')

depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libnotify'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
)
makedepends=(
  'gcc'
  'git'
  'imagemagick'
  'make'
  'nodejs>=24.13.1'
  'pnpm'
  'python'
  'rust'
)
optdepends=(
  'claude-code: drive Claude Code from the app'
  'cursor-cli: drive Cursor from the app'
  'github-copilot-cli: drive Copilot from the app'
  'openai-codex: drive Codex from the app'
)
provides=("t3code=${pkgver}")
conflicts=('t3code')
options=('!debug' '!strip')

_archive="t3code-${pkgver}.tar.gz"
_appimage="T3-Code-${pkgver}-arm64.AppImage"
source=(
  't3code-launcher.sh'
  't3-launcher.sh'
)
source_aarch64=("${_archive}::https://github.com/pingdotgg/t3code/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=(
  'cb905ff341372ef2ef6e402cf485959f8bd1df8f0efebee4cda1afdd5e6abc0a'
  'c5b3f2a9f0b14b12cfd973b79319f0f018b7ae49a1d43d8ca346100c3f7de28f'
)
sha256sums_aarch64=('40cda9960b8373f9dd32303b792744ee25a0514450a23031a8d9ea2556ea9655')

prepare() {
  cd "t3code-${pkgver}"
  pnpm install --frozen-lockfile
}

build() {
  cd "t3code-${pkgver}"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/cargo-target"
  export T3CODE_DESKTOP_OUTPUT_DIR="$srcdir/release"
  pnpm run dist:desktop:artifact \
    --platform linux --target AppImage --arch arm64 --output-dir "$srcdir/release"
  [[ -f $srcdir/release/$_appimage ]] || {
    echo "T3 Code did not produce the expected ARM64 AppImage" >&2
    return 1
  }
}

package() {
  chmod +x "$srcdir/release/$_appimage"
  "$srcdir/release/$_appimage" --appimage-extract >/dev/null
  cd "$srcdir/squashfs-root"

  # Fail closed if the AppImage begins carrying unexpected compatibility
  # files, matching the upstream packaging guard while retaining ARM builds.
  local unexpected
  unexpected=$(find usr \( -type f -o -type l \) | grep -vE \
    '^usr/share/icons/hicolor/[0-9]+x[0-9]+/apps/t3code\.png$|^usr/lib/lib(Xss\.so\.1|Xtst\.so\.6|appindicator\.so\.1|gconf-2\.so\.4|indicator\.so\.7|notify\.so\.4)$' || true)
  if [[ -n $unexpected ]]; then
    echo "Unexpected files in the AppImage's usr/ tree:" >&2
    echo "$unexpected" >&2
    return 1
  fi

  local icon size
  for icon in usr/share/icons/hicolor/*/apps/t3code.png; do
    size="${icon#usr/share/icons/hicolor/}"
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${size%%/*}/apps/t3code.png"
  done

  sed -e 's|^Exec=.*|Exec=t3code %U|' -e 's|^Name=.*|Name=T3 Code|' \
    -e '/^X-AppImage-Version=/d' t3code.desktop > "$srcdir/t3code.desktop.arch"
  install -Dm644 "$srcdir/t3code.desktop.arch" \
    "$pkgdir/usr/share/applications/t3code.desktop"

  rm -rf AppRun .DirIcon usr t3code.desktop t3code.png
  install -d "$pkgdir/usr/lib/t3code"
  cp -a . "$pkgdir/usr/lib/t3code/"
  chmod -R a+rX "$pkgdir/usr/lib/t3code"

  # Preserve Electron's sandbox on kernels that deny unprivileged user
  # namespaces, as in the upstream pkgrel=2 packaging update.
  chmod 4755 "$pkgdir/usr/lib/t3code/chrome-sandbox"

  install -Dm755 "$srcdir/t3code-launcher.sh" "$pkgdir/usr/bin/t3code"
  install -Dm755 "$srcdir/t3-launcher.sh" "$pkgdir/usr/bin/t3"
  install -Dm644 "$srcdir/t3code-${pkgver}/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
